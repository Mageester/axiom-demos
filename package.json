{
  "name": "axiom-demos",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:demo": "node scripts/build-demo.mjs",
    "build:restaurant": "npm run build:demo -- restaurant",
    "build:landscaping": "npm run build:demo -- landscaping",
    "build:roofing": "npm run build:demo -- roofing",
    "build:all": "npm run build:demo -- restaurant landscaping roofing",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "npm run build && vite preview",
    "deploy": "npm run build",
    "deploy:restaurant": "npm run build:restaurant && npx wrangler pages deploy dist --project-name axiom-demos-restaurant",
    "deploy:landscaping": "npm run build:landscaping && npx wrangler pages deploy dist --project-name axiom-demos-landscaping",
    "deploy:roofing": "npm run build:roofing && npx wrangler pages deploy dist --project-name axiom-demos-roofing"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "wrangler": "^4.71.0"
  }
}
